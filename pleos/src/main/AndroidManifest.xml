<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pleos Vehicle SDK: 주행거리·기어(CAR_DRIVE), 연료·배터리(CAR_ENERGY) 조회 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- AAOS 표준: 차속, 연료 탱크 용량 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- 지나온 길: GPS / 지명: Pleos NaviHelper 현재 위치·주소 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 출발 전 동승자 이름을 말로 입력할 때만 쓴다. (Pleos SpeechToText SDK) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
</manifest>
